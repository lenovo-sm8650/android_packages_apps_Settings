    <string name="lenovo_standby_title">மேம்படுத்தப்பட்ட காத்திருப்பு</string>
    <string name="lenovo_standby_summary">திரை அணைந்த சில நிமிடங்களுக்குப் பிறகு செயலற்ற ஆப்ஸை உறக்கத்தில் வைக்கும்; இதனால் காத்திருப்பில் பேட்டரி நீண்ட நேரம் நிற்கும்</string>
    <string name="lenovo_bypass_title">பைபாஸ் சார்ஜிங்</string>
    <string name="lenovo_bypass_intro">செருகியிருக்கும்போது, டேப்லெட் நீங்கள் அமைத்த பேட்டரி வரம்புக்குள் சார்ஜரின் மின்சக்தியில் நேரடியாக இயங்கும்; இதனால் நீண்ட அமர்வுகளில் பேட்டரி முழுமையாக சார்ஜ் ஆன நிலையில் இருக்காது, சூடாகாது.</string>
    <string name="lenovo_bypass_main_title">பைபாஸ் சார்ஜிங்கைப் பயன்படுத்து</string>
    <string name="lenovo_bypass_mode_category">பயன்படுத்து</string>
    <string name="lenovo_bypass_always_title">எப்போதும்</string>
    <string name="lenovo_bypass_always_summary">சார்ஜரை அகற்றிய பிறகும் இயக்கத்தில் இருக்கும்</string>
    <string name="lenovo_bypass_once_title">இந்த முறை மட்டும்</string>
    <string name="lenovo_bypass_once_summary">சார்ஜரை அகற்றும்போது அணைந்துவிடும்</string>
    <string name="lenovo_bypass_range_category">பேட்டரி வரம்பு</string>
    <string name="lenovo_bypass_range_title">கீழ், மேல் வரம்பு</string>
    <string name="lenovo_bypass_footer">இயக்கும்போது அல்லது மேல் வரம்புக்குக் கீழே செருகும்போது, டேப்லெட் முதலில் மேல் வரம்பு வரை சார்ஜ் ஆகும். பிறகு சார்ஜரின் மின்சக்தியில் இயங்கி, பேட்டரி கீழ் வரம்பை அடையும்போது மட்டுமே மீண்டும் சார்ஜ் செய்யும். மேல் வரம்புக்கு மேலே, மேல் வரம்பை அடையும் வரை பேட்டரியில் இயங்கும்.</string>
