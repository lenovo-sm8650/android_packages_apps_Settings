    <string name="lenovo_charging_protect_title">பேட்டரி பாதுகாப்பு</string>
    <string name="lenovo_charging_protect_summary" formatted="false">எப்போதும் செருகியிருக்கும் டேப்லெட்டுக்கு பேட்டரியை 40%-க்கும் 60%-க்கும் இடையில் வைத்திருக்கும்</string>
    <string name="lenovo_battery_category">பேட்டரி</string>
    <string name="lenovo_battery_maintenance_title">பேட்டரி ஆரோக்கிய மேம்படுத்தல்</string>
    <string name="lenovo_battery_maintenance_summary">பேட்டரி பழையதாகும்போது சார்ஜிங் மின்னழுத்தத்தை படிப்படியாகக் குறைக்கும்</string>
    <string name="lenovo_battery_info_title">பேட்டரி நிலை</string>
