<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/lenovo_charging_optimization_title">

    <PreferenceCategory
        android:key="lenovo_charging"
        android:title="@string/lenovo_charging_category">

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="lenovo_charging_normal"
            android:title="@string/lenovo_charging_normal_title"
            android:summary="@string/lenovo_charging_normal_summary"
            android:persistent="false" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="lenovo_charging_limit"
            android:title="@string/lenovo_charging_limit_title"
            android:summary="@string/lenovo_charging_limit_summary"
            android:persistent="false" />

        <com.android.settingslib.widget.SelectorWithWidgetPreference
            android:key="lenovo_charging_protect"
            android:title="@string/lenovo_charging_protect_title"
            android:summary="@string/lenovo_charging_protect_summary"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lenovo_battery"
        android:title="@string/lenovo_battery_category">

        <com.android.settings.custom.preference.GlobalSettingSwitchPreference
            android:key="battery_maintenance_on"
            android:title="@string/lenovo_battery_maintenance_title"
            android:summary="@string/lenovo_battery_maintenance_summary"
            android:defaultValue="true" />

        <Preference
            android:key="lenovo_battery_info"
            android:title="@string/lenovo_battery_info_title"
            android:selectable="false" />

    </PreferenceCategory>
</PreferenceScreen>
